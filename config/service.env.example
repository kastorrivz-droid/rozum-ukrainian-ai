# Non-secret HTTP receiver settings. Do not put HMAC secrets in this file.
ROZUM_KEY_REGISTRY=/secure/config/key-registry.json
ROZUM_POLICY=config/receiver-policy.v2.1.json
ROZUM_REPLAY_DB=/var/lib/rozum/replay.sqlite3
ROZUM_RECEIVER_ID=argos_receiver
ROZUM_RECEIVER_KEY_ID=manual-errors-v1
ROZUM_MAX_BODY_BYTES=1048576
ROZUM_BODY_TIMEOUT_SECONDS=10
ROZUM_LIMIT_CONCURRENCY=100
