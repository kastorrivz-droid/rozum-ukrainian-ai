# Keep the deterministic mock until a backend secret and spend guard are configured.
REEVES_PROVIDER=mock

# To enable the server-side OpenAI adapter, set these in the hosting provider's
# secret/environment settings. Never commit the real API key or put it in Pages.
# REEVES_PROVIDER=openai
# OPENAI_API_KEY=managed-as-a-secret
# OPENAI_MODEL=<model enabled for the API project>
REEVES_MAX_OUTPUT_TOKENS=500
REEVES_PROVIDER_TIMEOUT_SECONDS=25

# Comma-separated browser origins. Never use * for the dialogue API.
REEVES_ALLOWED_ORIGINS=https://kastorrivz-droid.github.io

# Provider keys belong in deployment secrets, never in this file or Git.
