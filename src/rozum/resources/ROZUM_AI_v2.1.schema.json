{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rozum.local/schemas/ROZUM_AI_v2.1.schema.json",
  "title": "ROZUM_AI_v2.1 Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "protocol_version",
    "id",
    "timestamp",
    "sender_id",
    "key_id",
    "author",
    "intent",
    "reply_to",
    "context",
    "data",
    "question",
    "output_format",
    "signature"
  ],
  "properties": {
    "protocol": {"const": "ROZUM_AI_v2"},
    "protocol_version": {"const": "2.1"},
    "id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "sender_id": {"type": "string", "minLength": 1},
    "key_id": {"type": "string", "minLength": 1},
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "intent": {"type": "string", "minLength": 1},
    "message_type": {"type": "string", "minLength": 1},
    "reply_to": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "format": "uuid"}
      ]
    },
    "context": {
      "type": "object",
      "required": ["session_id"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "state": {"type": "object"},
        "summary": {"type": "string"},
        "handoff": {"type": "object"}
      },
      "additionalProperties": true
    },
    "data": {"type": "object"},
    "question": {"type": "string"},
    "output_format": {"type": "string", "minLength": 1},
    "signature": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
      ]
    }
  }
}
